exports[`tool: read_thread > golden surface 1`] = `
{
  "name": "read_thread",
  "description": "Read a whole conversation thread in order. Two sources: a CRM client conversation by its id (email/sms/phone channels the business runs — pass conversation_id; call with no args first to list recent ones), or the owner's own chat log for a given day (pass date YYYY-MM-DD). Use for 'pull up that conversation with X', 'what did the client say in that thread', 'show me what we talked about Tuesday'. Read-only. For SEARCHING history use recall_sessions; this reads a known thread end to end.",
  "input_schema": {
    "type": "object",
    "properties": {
      "conversation_id": {
        "type": "string",
        "description": "CRM conversation id. Omit with no date to list recent conversations and their ids."
      },
      "date": {
        "type": "string",
        "description": "YYYY-MM-DD — read that day of the owner's own chat log instead of a CRM thread."
      },
      "limit": {
        "type": "number",
        "description": "Max messages to show. Default 20 (CRM) / 200 (own log)."
      }
    }
  },
  "category": "research.run",
  "reversible": true,
  "speed": "fast"
}
`;

exports[`tool: recall_sessions > golden surface 1`] = `
{
  "name": "recall_sessions",
  "description": "Search past conversations with Alex — full-text over every prior chat session, months back. Use when a request references something discussed before: 'what did we decide about X', 'didn't I ask you about this already', 'find that thing Alex mentioned last month', or when today's ask clearly continues earlier work you don't have in context. Returns matching moments with their session date and topic. Read-only; searches only your own history.",
