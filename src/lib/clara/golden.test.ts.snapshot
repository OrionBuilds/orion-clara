exports[`tool: decide > golden surface 1`] = `
{
  "name": "decide",
  "description": "Record Alex's answer to something Clara (or FRIDAY through Clara) asked them: approve, hold (reject), or defer to a later time. Use when they answer a question you asked, or name the item (\\"go ahead with the Acme Co report\\", \\"hold the Initech budget change\\", \\"send it Monday\\"). Never invent a decision they did not state; if it's unclear which item they mean, leave reference empty and Clara will ask which one.",
  "input_schema": {
    "type": "object",
    "properties": {
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject",
          "defer"
        ]
      },
      "reference": {
        "type": "string",
        "description": "The owner's words naming the item, verbatim (client, project, or what it does)."
      },
      "defer_until": {
        "type": "string",
        "description": "For defer: their words for when (\\"Monday\\", \\"tomorrow\\", \\"next week\\")."
      }
    },
    "required": [
      "decision"
    ]
  },
  "category": "research.run",
  "reversible": false,
  "speed": "fast"
}
`;

exports[`tool: deep_work > golden surface 1`] = `
{
  "name": "deep_work",
  "description": "THE tool for any request whose answer is a document, plan, or report — if Alex asks for something that would take a person hours at a desk, this is it. Triggers include: 'I need a proposal for <client>', 'draft the contract/bylaws/agreement set', 'research X and write it up', 'turn this into a polished client PDF', 'build me a report/document package', or any ask for 'docs', 'documents', or 'deliverables'. Runs autonomously in the background — researches the subject, builds branded documents (PDF/DOCX/XLSX), files them in Drive, and pings Alex with links plus anything needing their call. Do NOT fall through to the conversational engine for these — it talks about document work without producing files. NOT for quick questions, calendar/email reads, or single Drive lookups.",
  "input_schema": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string",
        "description": "The full work request in Alex's words, including the subject/client and the deliverables wanted."
      },
      "client": {
        "type": "string",
        "description": "Client or counterparty name, when the work is for one."
      },
      "when": {
        "type": "string",
        "enum": [
          "now",
          "queue"
        ],
        "description": "'now' runs immediately; 'queue' hands it to the overnight shift (Alex saying 'tonight/overnight/queue it' means queue). Omit to choose by time of day — evening asks queue by default."
      },
      "override_overdue_gate": {
        "type": "boolean",
        "description": "Set true only if Alex explicitly said to proceed despite an overdue invoice after being told about it (e.g. \\"do it anyway\\")."
      }
    },
    "required": [
      "task"
    ]
  },
  "category": "drive.create",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: delegate_to_agent > golden surface 1`] = `
{
  "name": "delegate_to_agent",
  "description": "Dispatch work to FRIDAY (software, deploys, repos, infrastructure, client deliverables, SEO). Use it whenever Alex tells you to have, ask or get FRIDAY to do something, or names work squarely in her domain. When Alex asks, the hand-off fires immediately and reports the task id the department queued so it's provable; asks from anyone else queue for Alex's one-tap approval first. We don't offer paid ads or marketing — never dispatch ads/campaign/creative work; say plainly it's not a service we offer.",
  "input_schema": {
    "type": "object",
    "properties": {
      "agent": {
        "type": "string",
        "enum": [
          "friday"
        ]
      },
      "task": {
        "type": "string",
        "description": "The request, in the owner's own words plus any context the head needs."
      },
      "client": {
        "type": "string",
        "description": "Client or counterparty name, when this dispatch is client work — enables the overdue-invoice check."
      },
      "override_overdue_gate": {
        "type": "boolean",
        "description": "Set true only if Alex explicitly said to proceed despite an overdue invoice after being told about it."
      }
    },
    "required": [
      "agent",
      "task"
    ]
  },
  "category": "research.run",
  "reversible": false,
  "speed": "slow"
}
`;

