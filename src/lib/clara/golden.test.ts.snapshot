exports[`tool: block_sender > golden surface 1`] = `
{
  "name": "block_sender",
  "description": "Stop a sender's mail from reaching the owner's inbox. Use for spam, phishing, or anyone the owner says they don't want to hear from. Accepts one address, or a bare domain to block everything from it. Never deletes mail — it is archived and stays findable.",
  "input_schema": {
    "type": "object",
    "properties": {
      "sender": {
        "type": "string",
        "description": "Address like \\"noreply@x.com\\", or a bare domain like \\"x.com\\" to block the whole domain."
      },
      "reason": {
        "type": "string",
        "description": "Short note on why, e.g. 'phishing pretending to be Amazon'."
      }
    },
    "required": [
      "sender"
    ]
  },
  "category": "email.work",
  "reversible": true,
  "speed": "fast"
}
`;

