exports[`tool: drive_edit > golden surface 1`] = `
{
  "name": "drive_edit",
  "description": "Change an EXISTING Drive file — append text to a Doc, replace text in a Doc, write cells in a Sheet, or overwrite a plain file. Read the file first (drive_read) so \`find\` strings are copied verbatim. When the owner asks directly it's applied at once; otherwise it queues for their confirmation.",
  "input_schema": {
    "type": "object",
    "properties": {
      "file_id": {
        "type": "string"
      },
      "change_summary": {
        "type": "string",
        "description": "One line describing the change, in plain English."
      },
      "op": {
        "type": "string",
        "enum": [
          "docs-insert",
          "docs-replace",
          "sheets-write",
          "drive-replace-content"
        ],
        "description": "docs-insert appends \`text\` to the end of a Doc; docs-replace swaps each \`replacements[].find\` for its \`replace\` in a Doc; sheets-write writes \`values\` into \`range\`; drive-replace-content overwrites a plain (non-Google) file with \`text\`."
      },
      "text": {
        "type": "string",
        "description": "docs-insert: the text to append (start with \\\\n\\\\n for a new paragraph; use \\\\n between lines). drive-replace-content: the complete new file content."
      },
      "replacements": {
        "type": "array",
        "description": "docs-replace only: exact, case-sensitive text to find (copied verbatim from drive_read) and what to put in its place. Every occurrence of \`find\` is replaced, so make it specific.",
        "items": {
          "type": "object",
