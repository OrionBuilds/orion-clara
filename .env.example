# Clara settings
# Copy to .env.local and fill in what you use. Never commit the filled-in file.
# Anything you leave empty is either optional or has a safe default.

# ─── Required: Orion connection ───────────────────────────────────────────────────────────
ORION_SUPABASE_URL=https://<your-project-ref>.supabase.co
ORION_SUPABASE_ANON_KEY=
# Orion's MCP server (from Orion's mcp-server folder), e.g. http://127.0.0.1:3100/mcp
ORION_MCP_URL=
# Where Orion sends Clara back after she signs in with her own staff account
ORION_REDIRECT_URI=http://127.0.0.1:3939/os/auth/capture
# Your user id in Orion (Settings → Organization → Staff Management)
ORION_OWNER_USER_ID=
# Clara's own staff account email in Orion
CLARA_OS_AGENT_EMAIL=

# ─── Required: who Clara works for ────────────────────────────────────────────────────────
# Path to your owner profile. Start from owner-profile.example.json.
ORION_OWNER_PROFILE=./owner-profile.json
CLARA_TZ=America/New_York
OWNER_PHONE=
OWNER_PERSONAL_PHONE=
OWNER_EMAIL_WORK=
OWNER_WORK_PHONE=
# Long random string, the same value in Clara, FRIDAY and Orion
INTERAGENT_SHARED_SECRET=

# ─── Required: AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Path to the claude CLI if it isn't on PATH
CLARA_CLAUDE_BIN=
CLARA_CLAUDE_MODEL=
# Optional: Gemini as a primary or fallback model (pick it in Orion → Settings → AI Agents → CLARA)
GEMINI_API_KEY=
CLARA_GEMINI_THINKING_TOKENS=
# Set to off to ignore Orion's per-agent settings and use built-in defaults
CLARA_AGENT_SETTINGS=

# ─── Mail and calendar: Google ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CLARA_DRIVE_ID=
CLARA_GOOGLE_MAPS_API_KEY=
CLARA_GOOGLE_PLACES_API_KEY=

# ─── Mail and calendar: Microsoft 365 ─────────────────────────────────────────────────────
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=
MS_OAUTH_REDIRECT_URI=
MS_SHAREPOINT_SITE_ID=
MS_SHAREPOINT_DRIVE_ID=

# ─── Booking ──────────────────────────────────────────────────────────────────────────────
CLARA_BOOKING_URL=
CLARA_BOOKING_CALENDAR_ID=
CLARA_BOOKING_TYPE_ID=
CLARA_BOOKING_TZ=

# ─── Phone, SMS and voice (optional) ──────────────────────────────────────────────────────
CLARA_TWILIO_ACCOUNT_SID=
CLARA_TWILIO_AUTH_TOKEN=
CLARA_TWILIO_NUMBER=
CLARA_WORKLINE_NUMBER=
# Public HTTPS address Twilio can reach (a tunnel or reverse proxy in front of Clara)
CLARA_PUBLIC_WEBHOOK_BASE=
TWILIO_ENFORCE_SIGNATURE=true
# Comma-separated numbers allowed to text Clara as the owner
WHITELIST_NUMBERS=
OS_SMS_RELAY_SECRET=
ELEVENLABS_API_KEY=
CLARA_ELEVENLABS_VOICE_ID=
# Local call transcription (whisper.cpp)
CLARA_WHISPER_BIN=
CLARA_WHISPER_MODEL=
CLARA_FFMPEG_BIN=

# ─── Other agents ─────────────────────────────────────────────────────────────────────────
FRIDAY_BASE_URL=http://127.0.0.1:3737

# ─── Local models (optional, Tier 2 machines) ─────────────────────────────────────────────
CLARA_LMSTUDIO_URL=
CLARA_LMSTUDIO_MODEL=
CLARA_LMSTUDIO_EMBED_MODEL=
CLARA_EMBED_MODEL=

# ─── Prospecting (optional) ───────────────────────────────────────────────────────────────
CLARA_PROSPECTING=
CLARA_PROSPECT_DAY_MAX_USD=
CLARA_ICP_DRIVE_ID=
CLARA_BUSINESS_PITCH=
CLARA_APOLLO_API_KEY=
CLARA_HUNTER_API_KEY=
CLARA_LEADMAGIC_API_KEY=
CLARA_BRAVE_SEARCH_API_KEY=
CLARA_META_AD_LIBRARY_TOKEN=

# ─── Where Clara keeps her files ──────────────────────────────────────────────────────────
CLARA_VAULT_ROOT=
CLARA_MEMORY_ROOT=
CLARA_KNOWLEDGE_DIR=./knowledge

# ─── Remote access (optional: only if Clara sits behind Cloudflare Access) ────────────────
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ─── Budgets and safety (sensible defaults; change only if you need to) ───────────────────
CLARA_DAY_MAX_COST_USD=
CLARA_DAILY_JOB_CAP=
CLARA_JOB_MAX_CALLS=
CLARA_QUIET_HOURS=
CLARA_OUTBOUND_MAX_PER_CONTACT_DAY=
CLARA_OUTBOUND_GLOBAL_HOUR_BREAKER=

# ─── Daily rhythm and switches (leave empty for the defaults) ─────────────────────────────
# Scheduled work from Orion's Agent Schedules: off, shadow or active (default shadow)
CLARA_OS_TASKS=
# Morning brief phone call time, e.g. 08:30, or off
CLARA_MORNING_CALL=
CLARA_MORNING_CALL_WEEKENDS=
# Overnight deep-work shift
CLARA_OVERNIGHT=
# Putting urgent callers through to you
CLARA_PUT_THROUGH=
CLARA_NOTIFY_MODE=
# Comma-separated dates (YYYY-MM-DD) Clara treats as days off
CLARA_HOLIDAYS=
# Email domains Clara should never treat as clients
CLARA_IGNORED_CLIENT_DOMAINS=
# Your location, for weather in briefs
CLARA_HOME_LAT=
CLARA_HOME_LNG=

# ─── iMessage relay via BlueBubbles (optional, needs a Mac) ───────────────────────────────
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=
